<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Portfolio | Bishal Rijal</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      background: #f9fafb;
      color: #111827;
      line-height: 1.6;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    /* Layout */
    .container {
      max-width: 1100px;
      margin: auto;
      padding: 40px 20px;
    }

    /* Header */
    header {
      background: #111827;
      color: #fff;
      padding: 20px 0;
    }

    nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
    }

    nav h1 {
      font-size: 24px;
    }

    nav ul {
      list-style: none;
      display: flex;
      gap: 20px;
    }

    nav ul li {
      font-size: 14px;
    }

    /* Hero */
    .hero {
      padding: 80px 20px;
      text-align: center;
      background: linear-gradient(135deg, #2563eb, #1e40af);
      color: #fff;
    }

    .hero h2 {
      font-size: 36px;
      margin-bottom: 15px;
    }

    .hero p {
      font-size: 18px;
      max-width: 600px;
      margin: auto;
    }

    /* Section */
    section h3 {
      font-size: 28px;
      margin-bottom: 20px;
      text-align: center;
    }

    /* About */
    .about p {
      max-width: 800px;
      margin: auto;
      text-align: center;
    }

    /* Skills */
    .skills {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 20px;
      margin-top: 30px;
    }

    .skill-box {
      background: #fff;
      padding: 20px;
      text-align: center;
      border-radius: 8px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.05);
      font-weight: bold;
    }

    /* Projects */
    .projects {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
      margin-top: 30px;
    }

    .project-card {
      background: #fff;
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }

    .project-card h4 {
      margin-bottom: 10px;
    }

    /* Experience */
    .experience {
      max-width: 800px;
      margin: auto;
    }

    .exp-item {
      background: #fff;
      padding: 20px;
      border-left: 4px solid #2563eb;
      margin-bottom: 20px;
      border-radius: 5px;
    }

    /* Contact */
    .contact {
      text-align: center;
    }

    .contact p {
      margin-bottom: 10px;
    }

    .contact a {
      display: inline-block;
      margin-top: 10px;
      padding: 10px 25px;
      background: #2563eb;
      color: #fff;
      border-radius: 5px;
    }

    /* Footer */
    footer {
      background: #111827;
      color: #9ca3af;
      text-align: center;
      padding: 15px;
      font-size: 14px;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .hero h2 {
        font-size: 28px;
      }

      nav ul {
        margin-top: 10px;
        width: 100%;
        justify-content: center;
      }
    }
  </style>
</head>
<body>

  <!-- Header -->
  <header>
    <div class="container">
      <nav>
        <h1>Bishal Rijal</h1>
        <ul>
          <li><a href="#about">About</a></li>
          <li><a href="#skills">Skills</a></li>
          <li><a href="#projects">Projects</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <!-- Hero -->
  <section class="hero">
    <h2>Hi, I'm Bishal Rijal 👋</h2>
    <p>Full Stack Developer | Digital Marketer | Educator</p>
  </section>

  <!-- About -->
  <section id="about" class="container about">
    <h3>About Me</h3>
    <p>
      I’m a passionate developer and educator who loves building real-world projects
      and simplifying complex topics for learners.
    </p>
  </section>

  <!-- Skills -->
  <section id="skills" class="container">
    <h3>Skills</h3>
    <div class="skills">
      <div class="skill-box">HTML</div>
      <div class="skill-box">CSS</div>
      <div class="skill-box">JavaScript</div>
      <div class="skill-box">React</div>
      <div class="skill-box">Node.js</div>
      <div class="skill-box">SEO</div>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects" class="container">
    <h3>Projects</h3>
    <div class="projects">
      <div class="project-card">
        <h4>Portfolio Website</h4>
        <p>Responsive personal portfolio built with HTML & CSS.</p>
      </div>
      <div class="project-card">
        <h4>Marketing Dashboard</h4>
        <p>Digital marketing analytics dashboard for beginners.</p>
      </div>
      <div class="project-card">
        <h4>School Management App</h4>
        <p>Teacher routine and class management system.</p>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="container">
    <h3>Experience</h3>
    <div class="experience">
      <div class="exp-item">
        <h4>Computer Teacher</h4>
        <p>Teaching programming and computer science (Class 6–10).</p>
      </div>
      <div class="exp-item">
        <h4>Digital Marketing Trainer</h4>
        <p>Conducting practical workshops and live batches.</p>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="container contact">
    <h3>Contact</h3>
    <p>Email: your@email.com</p>
    <p>Location: Nepal</p>
    <a href="mailto:your@email.com">Hire Me</a>
  </section>

  <!-- Footer -->
  <footer>
    © 2026 Your Name. All rights reserved.
  </footer>

</body>
</html>
